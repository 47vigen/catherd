#!/usr/bin/env bun
// Codex CLI simulator for catherd's tests: behaviour comes from the JSON scenario in CATHERD_SIM_SCENARIO.
import { appendFileSync, mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, join } from "node:path";

const s = JSON.parse(readFileSync(process.env.CATHERD_SIM_SCENARIO ?? "", "utf8")) as Record<string, any>;
const args = process.argv.slice(2);
// byRung: overrides for one rung, keyed `model#effort` ("default" when no effort flag is passed).
const model = args.includes("-m") ? args[args.indexOf("-m") + 1] : undefined;
const effort =
  args.find((a) => a.startsWith("model_reasoning_effort="))?.slice("model_reasoning_effort=".length) ?? "default";
if (model) Object.assign(s, s.byRung?.[`${model}#${effort}`] ?? {});
const say = (text: string) => process.stdout.write(text.endsWith("\n") ? text : `${text}\n`);
if (s.envTo) appendFileSync(s.envTo, `${JSON.stringify({ args, envKeys: Object.keys(process.env) })}\n`);

if (args[0] === "--version") {
  say(`codex-cli ${s.version ?? "0.157.0"}`);
  process.exit(0);
}
if (args[0] === "login" && args[1] === "status") {
  if (s.loginHangMs) await Bun.sleep(s.loginHangMs);
  say(s.loggedIn === false ? "Not logged in" : "Logged in using ChatGPT");
  process.exit(s.loggedIn === false ? 1 : 0);
}
if (args[0] === "debug" && args[1] === "models") {
  say(JSON.stringify(s.models ?? { models: [] }));
  process.exit(0);
}
if (args[0] !== "exec") {
  process.stderr.write(`error: unrecognized subcommand '${args[0]}'\n`);
  process.exit(2);
}

let stdin = "";
try {
  stdin = readFileSync(0, "utf8");
} catch {
  // no stdin
}
writeFileSync(
  s.recordTo,
  JSON.stringify({
    args,
    stdin,
    cwd: process.cwd(),
    pwd: process.env.PWD ?? null,
    codexHome: process.env.CODEX_HOME ?? null,
  }),
);
const out = args.includes("-o") ? args[args.indexOf("-o") + 1] : undefined;
setTimeout(async () => {
  for (const t of s.touch ?? []) {
    mkdirSync(dirname(join(process.cwd(), t.path)), { recursive: true });
    writeFileSync(join(process.cwd(), t.path), t.content);
  }
  if (s.eventsFile) process.stdout.write(readFileSync(s.eventsFile, "utf8"));
  if (s.reply !== undefined && out) writeFileSync(out, s.reply);
  if (s.hangMs) await Bun.sleep(s.hangMs);
  process.exit(s.exitCode ?? 0);
}, s.delayMs ?? 0);
