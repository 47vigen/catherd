{
  "name": "catherd-cli",
  "version": "1.2.1",
  "description": "Herds coding agents: autopilot builds from your own Claude Code session.",
  "keywords": [
    "autopilot",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "codex",
    "coding-agents",
    "mcp",
    "opencode",
    "orchestration",
    "tui"
  ],
  "homepage": "https://github.com/47vigen/catherd#readme",
  "bugs": {
    "url": "https://github.com/47vigen/catherd/issues"
  },
  "license": "MIT",
  "author": "47vigen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/47vigen/catherd.git"
  },
  "bin": {
    "catherd": "src/cli.ts"
  },
  "files": [
    "src",
    "catalog",
    "plugin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tui-frames": "CATHERD_WRITE_FRAMES=1 bun test test/entry/tui/frames.test.tsx",
    "version-packages": "changeset version && bun scripts/stamp-plugin-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentui/core": "0.5.12",
    "@opentui/keymap": "0.5.12",
    "@opentui/react": "0.5.12",
    "citty": "^0.2.2",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
