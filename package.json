{
  "name": "catherd-cli",
  "version": "0.2.1",
  "description": "Herds coding agents: autopilot builds from your own Claude Code session.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/47vigen/catherd.git"
  },
  "bin": {
    "catherd": "src/cli.ts"
  },
  "files": [
    "src",
    "catalog",
    "plugin"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "version-packages": "changeset version && bun scripts/stamp-plugin-version.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentui/core": "^0.5.12",
    "@opentui/react": "^0.5.12",
    "citty": "^0.2.2",
    "react": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
