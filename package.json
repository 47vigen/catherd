{
  "name": "catherd-cli",
  "version": "1.5.0",
  "description": "Herds coding agents: autopilot builds from your own Claude Code session.",
  "keywords": [
    "autopilot",
    "claude-code",
    "claude-code-plugin",
    "cli",
    "codex",
    "coding-agents",
    "mcp",
    "opencode",
    "orchestration",
    "web-panel"
  ],
  "homepage": "https://github.com/47vigen/catherd#readme",
  "bugs": {
    "url": "https://github.com/47vigen/catherd/issues"
  },
  "license": "MIT",
  "author": "47vigen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/47vigen/catherd.git"
  },
  "bin": {
    "catherd": "src/cli.ts"
  },
  "files": [
    "src",
    "web/dist",
    "catalog",
    "plugin",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "panel:openapi": "bun scripts/panel-openapi.ts",
    "panel:build": "cd web && bun install --frozen-lockfile && bun run build",
    "prepack": "bun run panel:build",
    "version-packages": "changeset version && bun scripts/stamp-plugin-version.mjs",
    "release:publish": "npm view catherd-cli@$npm_package_version version >/dev/null 2>&1 || bun test/pack-smoke.ts && changeset publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "citty": "^0.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/bun": "^1.4.2",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
