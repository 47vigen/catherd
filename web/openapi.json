  "components": {
    "schemas": {
      "RunView": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "engine": {
            "type": "string",
            "enum": [
              "2.0",
              "1.5"
            ]
          },
          "phase": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "planning",
                  "approval",
                  "running",
                  "ended"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "done",
                  "cancelled",
                  "failed"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "daemon": {
            "type": "object",
            "properties": {
              "alive": {
                "type": "boolean"
              },
              "pid": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "beatAgeSec": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "alive",
              "pid",
              "beatAgeSec"
            ],
            "additionalProperties": false
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "round": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "commit": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "status",
                "round",
                "commit"
              ],
              "additionalProperties": false
            }
          },
          "live": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "rung": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "since": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "role",
                "rung",
                "unit",
                "since"
              ],
              "additionalProperties": false
            }
          },
          "parked": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParkedView"
            }
          },
          "holds": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quota": {
                  "type": "string"
                },
                "until": {
                  "type": "string"
                }
              },
              "required": [
                "quota",
                "until"
              ],
              "additionalProperties": false
            }
          },
          "last": {
            "type": [
              "string",
              "null"
            ]
          },
          "startedAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "repo",
          "engine",
          "phase",
          "outcome",
          "daemon",
          "milestones",
          "live",
          "parked",
          "holds",
          "last",
          "startedAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "ParkedView": {
        "type": "object",
        "properties": {
          "run": {
            "type": "string"
          },
          "runTitle": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "needs_user",
              "too_hard",
              "provider_error",
              "no_access",
              "check_broken",
              "out_of_scope",
              "environment",
              "preflight",
              "confirm",
              "approval",
              "blocker",
              "verifier",
              "commit",
              "land",
              "budget",
              "judge",
              "effect",
              "push"
            ]
          },
          "at": {
            "type": "string"
          },
          "command": {
            "type": "string"
          }
        },
        "required": [
          "run",
          "runTitle",
          "unit",
          "question",
          "reason",
          "at",
          "command"
        ],
        "additionalProperties": false
      },
      "TimelineEntry": {
        "type": "object",
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "at": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "seq",
          "at",
          "type",
          "text"
        ],
        "additionalProperties": false
      },
      "SetupView": {
        "type": "object",
        "properties": {
          "repo": {
            "type": [
              "string",
              "null"
            ]
          },
          "profile": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "active": {
                "type": "string"
              },
              "profiles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "active",
              "profiles"
            ],
            "additionalProperties": false
          },
          "catalog": {
            "$ref": "#/components/schemas/Check"
          },
          "backends": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          },
          "issues": {
            "type": "object",
            "properties": {
              "errors": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Issue"
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Issue"
                }
              }
            },
            "required": [
              "errors",
              "warnings"
            ],
            "additionalProperties": false
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "architect",
                    "verifier",
                    "worker",
                    "reviewer",
                    "ui-reviewer",
                    "artist",
                    "writer",
                    "researcher",
                    "judge"
                  ]
                },
                "enabled": {
                  "type": "boolean"
                },
                "rungs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rung": {
                        "type": "string"
                      },
                      "intelligence": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "rung",
                      "intelligence"
                    ],
                    "additionalProperties": false
                  }
                },
                "offered": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IndexedPair"
                  }
                }
              },
              "required": [
                "role",
                "enabled",
                "rungs",
                "offered"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "repo",
          "profile",
          "catalog",
          "backends",
          "issues",
          "roles"
        ],
        "additionalProperties": false
      },
      "Check": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "warn",
              "fail",
              "skip",
              "info"
            ]
          },
          "word": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "state",
          "word",
          "detail"
        ],
        "additionalProperties": false
      },
      "Issue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "IndexedPair": {
        "type": "object",
        "properties": {
          "rung": {
            "type": "string"
          },
          "intelligence": {
            "type": "number"
          },
          "price": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "number"
                  },
                  "output": {
                    "type": "number"
                  }
                },
                "required": [
                  "input",
                  "output"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "speed": {
            "type": [
              "number",
              "null"
            ]
          },
          "context": {
            "type": [
              "number",
              "null"
            ]
          },
          "cost": {
            "type": "object",
            "properties": {
              "tier": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 0
                  },
                  {
                    "type": "number",
                    "const": 1
                  }
                ]
              },
              "value": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "mode": {
                "type": "string",
                "enum": [
                  "chatgpt-plan",
                  "claude-plan",
                  "subscription",
                  "metered"
                ]
              }
            },
            "required": [
              "tier",
              "value",
              "mode"
            ],
            "additionalProperties": false
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "rung",
          "intelligence",
          "price",
          "speed",
          "context",
          "cost",
          "evidence"
        ],
        "additionalProperties": false
      },
      "ProfileSaved": {
        "type": "object",
        "properties": {
          "saved": {
            "type": "boolean"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Issue"
            }
          },
          "diff": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "before": {},
                "after": {}
              },
              "required": [
                "path",
                "before",
                "after"
              ],
              "additionalProperties": false
            }
          },
          "linked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pruned": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "newSessionNeededFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "saved",
          "errors",
          "warnings",
          "diff",
          "linked",
          "pruned",
          "newSessionNeededFor"
        ],
        "additionalProperties": false
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "fix": {
                "type": "string"
              }
            },
            "required": [
              "message",
              "type",
              "code"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "RunList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunView"
            }
          },
          "total": {
